# AI provider
# Which provider powers Mark by default when a user has not selected one.
# One of: claude | openai | gemini
LLM_PROVIDER=claude

# Claude
CLAUDE_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Supabase Auth + account persistence
# Add the same values in Vercel project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects can use this instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret used to ENFORCE the daily free-generation quota.
# Supabase dashboard -> Project Settings -> API -> service_role key.
# NEVER expose this to the client / commit it. Without it, quota enforcement is
# disabled (the app falls back to showing the tier limit without capping).
# Requires running supabase/migrations/0003_server_quota.sql.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (payments). Fill these to enable the Standard / Advanced subscriptions.
# See the "Payments" section in README.md for full setup steps.
# STRIPE_SECRET_KEY: Stripe dashboard -> Developers -> API keys (secret key).
# STRIPE_WEBHOOK_SECRET: from the webhook endpoint you register (or `stripe listen`).
# STRIPE_PRICE_*: the recurring Price IDs of the Standard ($4.99) and Advanced ($49.99) products.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_ADVANCED=

# Domain availability provider
# One of: rdap (free, availability only) | porkbun (availability + price) | namecheap (availability + price) | mock
DOMAIN_PROVIDER=rdap

# Porkbun API - only needed when DOMAIN_PROVIDER=porkbun.
# Create keys at https://porkbun.com/account/api
# The app only calls /domain/checkDomain/{domain}; it does not register domains.
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
PORKBUN_TIMEOUT_MS=25000
# Optional. Porkbun's default checkDomain limit is low (often 1 check / 10s).
# If you do not raise the rate limit in Porkbun, set this to 10000+ for slow but steady checks.
PORKBUN_CHECK_DELAY_MS=0

# Namecheap API - only needed when DOMAIN_PROVIDER=namecheap.
# Requirements: API access enabled on your account (needs 20+ domains OR
# $50 balance OR $50+ spent), and the server's public IPv4 whitelisted.
# Use the free sandbox (sandbox.namecheap.com) for development.
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_SANDBOX=true
NAMECHEAP_TIMEOUT_MS=25000
